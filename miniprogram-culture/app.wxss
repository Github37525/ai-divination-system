page {
  min-height: 100%;
  color: #1d2925;
  background: #f4efe3;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after {
  border: 0;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 30rpx 28rpx calc(54rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  color: #39786b;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
}

.page-title {
  display: block;
  margin-top: 18rpx;
  color: #15231f;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 54rpx;
  line-height: 1.25;
}

.muted {
  color: #71817b;
}

.paper-card {
  border: 1rpx solid rgba(45, 75, 65, .12);
  border-radius: 24rpx;
  background: rgba(255, 253, 247, .9);
  box-shadow: 0 18rpx 54rpx rgba(38, 51, 46, .08);
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  color: #24463c;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 36rpx;
  font-weight: 600;
}

.body-copy {
  color: #35433e;
  font-size: 28rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.text-link {
  color: #347c6c;
  font-size: 25rpx;
}
