.lead {
  display: block;
  margin: 18rpx 0 34rpx;
  font-size: 26rpx;
  line-height: 1.75;
}

.term-card {
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.term-head {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.term-head .section-title {
  margin: 0;
}

.term-index {
  color: #a44e3d;
  font-family: "DIN Alternate", sans-serif;
  font-size: 21rpx;
}

.back-link {
  margin-top: 38rpx;
  padding: 28rpx;
  color: #2f7162;
  border: 1rpx solid rgba(47, 113, 98, .2);
  border-radius: 20rpx;
  font-size: 27rpx;
  text-align: center;
}
