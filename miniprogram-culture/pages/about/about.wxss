.lead {
  display: block;
  margin: 18rpx 0 34rpx;
  font-size: 26rpx;
  line-height: 1.75;
}

.info-card {
  margin-bottom: 20rpx;
  padding: 30rpx;
}

.source-url {
  display: block;
  margin-top: 16rpx;
  color: #76857f;
  font-size: 20rpx;
  line-height: 1.6;
  word-break: break-all;
}

.integrity-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 34rpx;
  padding: 28rpx;
  color: #315a4e;
  border: 1rpx dashed rgba(49, 90, 78, .35);
  border-radius: 20rpx;
  font-size: 25rpx;
}

.hash {
  color: #6d7e78;
  font-family: monospace;
  font-size: 19rpx;
  line-height: 1.5;
  word-break: break-all;
}

.integrity-card .muted {
  font-size: 22rpx;
  line-height: 1.6;
}

.back-link {
  margin-top: 38rpx;
  padding: 28rpx;
  color: #2f7162;
  border: 1rpx solid rgba(47, 113, 98, .2);
  border-radius: 20rpx;
  font-size: 27rpx;
  text-align: center;
}
