.page-head {
  margin-bottom: 34rpx;
}

.title {
  display: block;
  margin: 20rpx 0 14rpx;
  color: #f2e3c4;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 52rpx;
}

.description {
  font-size: 25rpx;
  line-height: 1.7;
}

.empty {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 70rpx 32rpx 40rpx;
  color: #9ba9a6;
}

.empty-symbol {
  margin-bottom: 22rpx;
  color: #58d2c5;
  font-size: 90rpx;
}

.start-link {
  width: 100%;
  margin-top: 44rpx;
}

.history-card {
  margin-bottom: 22rpx;
  padding: 30rpx;
}

.card-top {
  display: flex;
  gap: 20rpx;
  justify-content: space-between;
}

.card-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.card-title {
  color: #ead7af;
  font-family: "STKaiti", serif;
  font-size: 34rpx;
}

.card-question {
  margin-top: 10rpx;
  color: #a3b0ad;
  font-size: 25rpx;
  line-height: 1.55;
}

.card-date {
  color: #60736f;
  font-size: 21rpx;
}

.card-interpretation {
  display: block;
  margin-top: 28rpx;
  padding-top: 24rpx;
  color: #d0d6cc;
  border-top: 1rpx solid rgba(255, 255, 255, .06);
  font-size: 26rpx;
  line-height: 1.85;
  white-space: pre-wrap;
}

.expand-hint {
  display: block;
  margin-top: 22rpx;
  color: #50c9bd;
  font-size: 22rpx;
  text-align: right;
}

.clear-button {
  margin-top: 34rpx;
}
