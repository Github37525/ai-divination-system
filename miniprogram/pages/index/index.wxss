.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 34rpx;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-right: 18rpx;
  color: #071015;
  border-radius: 50%;
  background: linear-gradient(135deg, #e4bd6d, #50d3c5);
  font-family: serif;
  font-size: 34rpx;
  font-weight: 700;
  vertical-align: middle;
}

.brand-name {
  color: #f1e3c4;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  vertical-align: middle;
}

.history-link {
  padding: 15rpx 24rpx;
  color: #a9c6c2;
  border: 1rpx solid rgba(82, 212, 198, .2);
  border-radius: 999rpx;
  font-size: 25rpx;
}

.setup-panel,
.result-panel {
  padding: 42rpx 34rpx;
}

.hero-title,
.result-title {
  display: block;
  margin-top: 24rpx;
  color: #f5e7c8;
  font-family: "STKaiti", "KaiTi", serif;
  font-size: 52rpx;
  line-height: 1.3;
}

.hero-copy {
  display: block;
  margin: 20rpx 0 34rpx;
  font-size: 27rpx;
  line-height: 1.75;
}

.question-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 230rpx;
  margin-bottom: 30rpx;
  padding: 28rpx;
  color: #f1e5cb;
  border: 1rpx solid rgba(207, 173, 105, .28);
  border-radius: 22rpx;
  background: rgba(0, 0, 0, .22);
  font-size: 29rpx;
  line-height: 1.65;
}

.placeholder {
  color: #657573;
}

.cast-head,
.line-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress {
  margin-top: 8rpx;
  color: #f2dfb9;
  font-family: "DIN Alternate", sans-serif;
  font-size: 54rpx;
}

.progress-total {
  color: #72817f;
  font-size: 28rpx;
}

.sensor-pill {
  width: auto;
  margin: 0;
  padding: 12rpx 24rpx;
  color: #acb9b6;
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .04);
  font-size: 24rpx;
  line-height: 1.5;
}

.sensor-pill.active {
  color: #071015;
  background: #55d6c8;
}

.coin-stage {
  position: relative;
  overflow: hidden;
  margin: 34rpx 0 28rpx;
  padding: 70rpx 24rpx 38rpx;
  border: 1rpx solid rgba(79, 211, 197, .2);
  border-radius: 34rpx;
  background: radial-gradient(circle at 50% 35%, rgba(53, 187, 175, .17), transparent 48%), rgba(7, 15, 21, .9);
}

.energy-ring {
  position: absolute;
  top: 38rpx;
  left: 50%;
  width: 410rpx;
  height: 410rpx;
  border: 2rpx solid #4cd2c5;
  border-radius: 50%;
  box-shadow: 0 0 60rpx rgba(76, 210, 197, .35);
  transform: translateX(-50%);
  transition: opacity .15s ease;
}

.coins {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.coin {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  color: #2d1d08;
  border: 8rpx double #624313;
  border-radius: 50%;
  background: radial-gradient(circle, #e8c77c 0 20%, #b97a2d 22% 66%, #f1d28b 69% 100%);
  box-shadow: 0 16rpx 28rpx rgba(0, 0, 0, .4), inset 0 0 18rpx #fff0b0;
  font-family: "STKaiti", serif;
  font-size: 31rpx;
  font-weight: 700;
  transition: transform .45s ease;
}

.coin.reverse {
  color: #0e5d56;
  background: radial-gradient(circle, #c1fff4 0 20%, #4fbeb2 22% 66%, #a6eee5 69% 100%);
  transform: rotateY(180deg);
}

.resolving .coin:nth-child(1) { animation: toss .75s ease; }
.resolving .coin:nth-child(2) { animation: toss .75s .08s ease; }
.resolving .coin:nth-child(3) { animation: toss .75s .16s ease; }

@keyframes toss {
  0% { transform: translateY(0) rotateY(0); }
  48% { transform: translateY(-90rpx) rotateY(540deg); }
  100% { transform: translateY(0) rotateY(1080deg); }
}

.stage-hint {
  position: relative;
  z-index: 1;
  display: block;
  min-height: 44rpx;
  margin-top: 46rpx;
  color: #a9bab7;
  font-size: 25rpx;
  line-height: 1.7;
  text-align: center;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.line-panel {
  margin-top: 30rpx;
  padding: 30rpx;
}

.line-panel-head {
  padding-bottom: 20rpx;
  color: #e8d5ad;
  font-size: 27rpx;
}

.line-panel-head .muted {
  font-size: 23rpx;
}

.empty-lines {
  padding: 42rpx 0 20rpx;
  font-size: 25rpx;
  text-align: center;
}

.line-row {
  display: flex;
  align-items: center;
  min-height: 86rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .06);
}

.line-glyph {
  width: 88rpx;
  color: #e8bd68;
  font-size: 55rpx;
}

.line-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  color: #eadfc8;
  font-size: 26rpx;
}

.line-source {
  margin-top: 5rpx;
  font-size: 21rpx;
}

.line-position {
  color: #58cfc3;
  font-size: 24rpx;
}

.result-meta {
  display: block;
  margin: 18rpx 0 28rpx;
  color: #7f9995;
  font-size: 22rpx;
}

.pending-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 26rpx;
  padding: 22rpx;
  color: #a9d9d4;
  border-radius: 18rpx;
  background: rgba(71, 205, 191, .08);
  font-size: 24rpx;
}

.pending-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #52d5c7;
  box-shadow: 0 0 20rpx #52d5c7;
  animation: pulse 1.1s ease infinite;
}

@keyframes pulse { 50% { opacity: .3; transform: scale(.7); } }

.interpretation {
  display: block;
  margin-bottom: 34rpx;
  color: #d6d9ce;
  font-size: 28rpx;
  line-height: 1.9;
  white-space: pre-wrap;
}

.result-panel .secondary-button,
.result-panel .primary-button {
  margin-top: 18rpx;
}

.status {
  margin-top: 28rpx;
  color: #758582;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.status.connected { color: #70c9bf; }
.status.error { color: #e88b78; }
