{
  "111111": {
    "name": "乾为天",
    "palace": "乾金",
    "shi": 6,
    "ying": 3,
    "judgement": "乾：元，亨，利，贞。",
    "lines": {
      "1": {"line_name": "初九", "text": "潜龙，勿用。"},
      "2": {"line_name": "九二", "text": "见龙在田，利见大人。"},
      "3": {"line_name": "九三", "text": "君子终日乾乾，夕惕若厉，无咎。"},
      "4": {"line_name": "九四", "text": "或跃在渊，无咎。"},
      "5": {"line_name": "九五", "text": "飞龙在天，利见大人。"},
      "6": {"line_name": "上九", "text": "亢龙，有悔。"}
    },
    "najia": ["甲子", "甲寅", "甲辰", "壬午", "壬申", "壬戌"]
  },
  "000000": {
    "name": "坤为地",
    "palace": "坤土",
    "shi": 6,
    "ying": 3,
    "judgement": "坤：元，亨，利牝马之贞。",
    "lines": {
      "1": {"line_name": "初六", "text": "履霜，坚冰至。"},
      "2": {"line_name": "六二", "text": "直，方，大，不习无不利。"},
      "3": {"line_name": "六三", "text": "含章可贞。或从王事，无成有终。"},
      "4": {"line_name": "六四", "text": "括囊，无咎，无誉。"},
      "5": {"line_name": "六五", "text": "黄裳，元吉。"},
      "6": {"line_name": "上六", "text": "龙战于野，其血玄黄。"}
    },
    "najia": ["乙未", "乙巳", "乙卯", "癸丑", "癸亥", "癸酉"]
  }
}